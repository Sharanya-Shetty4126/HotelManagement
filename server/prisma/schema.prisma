// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Admin {
  id            Int        @id @default(autoincrement())
  username      String     @unique
  passwordHash  String
  name          String
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model Table {
  id            Int        @id @default(autoincrement())
  number        Int        @unique
  section       String     // "AC" or "Non-AC"
  capacity      Int
  qrToken       String     @unique  // Signed token embedded in QR code
  sessions      TableSession[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model TableSession {
  id            String       @id @default(cuid())
  tableId       Int
  table         Table        @relation(fields: [tableId], references: [id])
  sessionCode   String       @unique  // Human-readable code for joining (e.g., "AB7X3")
  status        SessionStatus @default(ACTIVE)
  startedAt     DateTime     @default(now())
  endedAt       DateTime?
  guestCount    Int          @default(0)
  orders        Order[]
  bill          Bill?
  requests      CustomerRequest[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

enum SessionStatus {
  ACTIVE
  BILL_GENERATED
  CLOSED
}

model MenuCategory {
  id            Int          @id @default(autoincrement())
  name          String       @unique
  displayOrder  Int          @default(0)
  items         MenuItem[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model MenuItem {
  id            Int          @id @default(autoincrement())
  name          String
  description   String?
  price         Float
  emoji         String       @default("🍽️")
  isVeg         Boolean      @default(true)
  rating        Float        @default(0)
  available     Boolean      @default(true)
  categoryId    Int
  category      MenuCategory @relation(fields: [categoryId], references: [id])
  orderItems    OrderItem[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model Order {
  id            String       @id @default(cuid())
  sessionId     String
  session       TableSession @relation(fields: [sessionId], references: [id])
  placedAt      DateTime     @default(now())
  status        OrderStatus  @default(PENDING)
  items         OrderItem[]
  total         Float
  specialInstructions String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

enum OrderStatus {
  PENDING    // Waiting for admin acceptance
  ACCEPTED   // Admin has accepted
  PREPARING  // Being prepared
  READY      // Ready to serve
  SERVED     // All items served
}

model OrderItem {
  id            String       @id @default(cuid())
  orderId       String
  order         Order        @relation(fields: [orderId], references: [id])
  menuItemId    Int
  menuItem      MenuItem     @relation(fields: [menuItemId], references: [id])
  name          String       // Snapshot of item name at time of order
  quantity      Int
  price         Float        // Snapshot of price at time of order
  status        ItemStatus   @default(PENDING)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

enum ItemStatus {
  PENDING
  PREPARING
  READY
  SERVED
}

model Bill {
  id            String       @id @default(cuid())
  sessionId     String       @unique
  session       TableSession @relation(fields: [sessionId], references: [id])
  total         Float
  tax           Float
  serviceCharge Float
  grandTotal    Float
  generatedAt   DateTime     @default(now())
  paymentConfirmed Boolean    @default(false)
  confirmedAt   DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model CustomerRequest {
  id            String       @id @default(cuid())
  sessionId     String
  session       TableSession @relation(fields: [sessionId], references: [id])
  type          RequestType
  description   String?
  raisedAt      DateTime     @default(now())
  resolved      Boolean      @default(false)
  resolvedAt    DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

enum RequestType {
  WATER
  CUTLERY
  NAPKINS
  EXTRA_PLATES
  COMPLAINT
  ASSISTANCE
}